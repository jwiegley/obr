# Maintainer: John Wiegley <johnw@newartisans.com>
# obr-git - Build from source package for obr (issue tracker with an Org surface)
#
# To build: makepkg -si
# To install from AUR: yay -S obr-git

pkgname=obr-git
# Placeholder only; pkgver() below rewrites it from `git describe` at build
# time. The shape matches what that function produces for a tag carrying semver
# build metadata: `v0.5.7+1-0-g0000000` becomes `0.5.7+1.r0.g0000000`
# (leading v dropped, `-` runs turned into `.`). `+` is legal in pkgver; `-` is
# not, which is why the function rewrites them.
pkgver=0.5.7+1.r0.g0000000
pkgrel=1
pkgdesc="Issue tracker with an Org-file surface (SQLite cache + Org export) - git version"
arch=('x86_64' 'aarch64')
url="https://github.com/jwiegley/obr"
# The additional rider makes this non-SPDX; package installs full license below.
license=('LicenseRef-MIT-OpenAI-Anthropic-Rider')
provides=('obr')
conflicts=('obr' 'obr-bin')
makedepends=('rust' 'cargo' 'git')

source=("${pkgname}::git+https://github.com/jwiegley/obr.git")
sha256sums=('SKIP')

pkgver() {
    cd "${pkgname}"
    git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || \
        printf "0.0.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "${pkgname}"
    export CARGO_HOME="${srcdir}/cargo"
    cargo build --release --locked
}

check() {
    cd "${pkgname}"
    export CARGO_HOME="${srcdir}/cargo"
    cargo test --release --locked
}

package() {
    cd "${pkgname}"
    install -Dm755 "target/release/obr" "${pkgdir}/usr/bin/obr"
    install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
